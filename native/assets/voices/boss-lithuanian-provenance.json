{
  "engine": "edge-tts lt-LT-LeonasNeural, native Lithuanian TTS",
  "lines": [
    {
      "id": "boss_lt_0",
      "text": "Po velnių!",
      "language": "lt",
      "duration": 2.232,
      "sha256": "f724e656889380f070b295ebe28918d7b8e5f06b6e1d33b3a719c8c0a06e3e9a"
    },
    {
      "id": "boss_lt_1",
      "text": "Kad tave perkūnas!",
      "language": "lt",
      "duration": 3.0,
      "sha256": "d5c2d86db43e7b58b05dfe950978d1fb021fe44eeaee4a86cabf36f79cdf17e2"
    },
    {
      "id": "boss_lt_2",
      "text": "Šūdas! Dar atsiimsi!",
      "language": "lt",
      "duration": 5.112,
      "sha256": "f9f5f4fbee6c3e8685eb09c4f0450eb0f0fe9d5c8b23d2dd3a5135b231fc3ffd"
    },
    {
      "id": "boss_lt_3",
      "text": "Eik tu velniop!",
      "language": "lt",
      "duration": 2.688,
      "sha256": "c77f2729c6ec29bee1ebca4d56e83b74312767f54b37ca77f383b3f01c6778ac"
    },
    {
      "id": "boss_lt_4",
      "text": "Aš jus visus sugniušku!",
      "language": "lt",
      "duration": 3.216,
      "sha256": "cc138a405145c1552c513200c9c4afa8aa860a16a3db674f15feadb0fb7badfd"
    },
    {
      "id": "boss_lt_5",
      "text": "Jūnų negalėsite pabėgti!",
      "language": "lt",
      "duration": 3.24,
      "sha256": "e7f2dae0943320bad62c14e40293bf6d8b6d2a4c031389de339465e13438f8e1"
    },
    {
      "id": "boss_lt_6",
      "text": "Šiame pasaulyje nėra vietos baimingiesiems!",
      "language": "lt",
      "duration": 4.44,
      "sha256": "b5825ff11df5d4750a047b55a364275629a426b668d72408172977a0b0f238d6"
    },
    {
      "id": "boss_lt_7",
      "text": "Jėga manimi rūpinasi!",
      "language": "lt",
      "duration": 3.144,
      "sha256": "93c9910e5ee8878065cdcae16bae3bc77c645de5a15ae9949a7a316f03411a42"
    },
    {
      "id": "boss_lt_8",
      "text": "Aš esu amžinas!",
      "language": "lt",
      "duration": 2.832,
      "sha256": "53eaa821c58e48b9a9356fa84baa38e9ae186d5e5b421e38162e45b01713bd94"
    },
    {
      "id": "boss_lt_9",
      "text": "Jūsų pasaulis man nepatinka!",
      "language": "lt",
      "duration": 3.528,
      "sha256": "d8e9db0406bb4bdc1b38aa114fdeef5ae378e187f63c0a0ca1a70ed304aa41f3"
    },
    {
      "id": "boss_lt_10",
      "text": "Po velnių, jūs pažadinote mano įniršį!",
      "language": "lt",
      "duration": 4.248,
      "sha256": "fe4db12b4d88fcf165183c2fa92a1fbc4015fa406cd4aa23012d421172f9ec4c"
    },
    {
      "id": "boss_lt_11",
      "text": "Prakeikti, jūs vis dar stovite prieš mane!",
      "language": "lt",
      "duration": 4.584,
      "sha256": "55833f6bc203c75d26923670dfccfabdcea1e2e8963c1066a04c9b35cbe467a2"
    },
    {
      "id": "boss_lt_12",
      "text": "Velnias, mano pyktis tik auga!",
      "language": "lt",
      "duration": 3.864,
      "sha256": "42599478e9cc547cec7b411391e8aa687ffd22ab1f306e00f8f82d90d0b93d16"
    },
    {
      "id": "boss_lt_13",
      "text": "Šūdas, dabar pajusite mano tikrąją galią!",
      "language": "lt",
      "duration": 4.536,
      "sha256": "12bb7201e18041e0a13e5344e4d4636b0d965439edf24b5ae03de2dd215210ad"
    },
    {
      "id": "boss_lt_14",
      "text": "Eikite po velnių, niekas manęs nesustabdys!",
      "language": "lt",
      "duration": 4.704,
      "sha256": "cf1fe90a9fe49549a09c9796ee3bad3909538f69e9292d692871c525284cbdc6"
    },
    {
      "id": "boss_lt_15",
      "text": "Kad jus kur perkūnas, aš dar nebaigiau!",
      "language": "lt",
      "duration": 4.536,
      "sha256": "f9c1cb001e19d5d14f62b3a0674cd05dd5677bfad62969f9b9ea7bf516d091f5"
    },
    {
      "id": "boss_lt_16",
      "text": "Po velnių, šis pasaulis sugrius kartu su jumis!",
      "language": "lt",
      "duration": 4.656,
      "sha256": "d214ab3c8793f2543ed62849c820c9324a635a16e91fd694f6426e81deb0d37b"
    },
    {
      "id": "boss_lt_17",
      "text": "Prakeikimas, jūs pažadinote paskutinę mano galią!",
      "language": "lt",
      "duration": 4.848,
      "sha256": "ef6fb3b9c60b9e724ce98e3341bea1184b4579295ef9b80a399df2ffda59c9db"
    }
  ]
}